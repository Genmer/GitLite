{
  "name": "@gitlite/adapters-node",
  "version": "0.3.0",
  "description": "Node.js runtime adapter for GitLite (fs/crypto/credential/fetch)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
