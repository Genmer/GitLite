{
  "name": "gitlite-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core -w packages/adapters-node -w packages/sdk -w packages/cli",
    "test": "npm run test -w packages/core -w packages/sdk -w packages/cli",
    "test:core": "npm run test -w packages/core",
    "typecheck": "tsc -b packages/core packages/adapters-node packages/sdk packages/cli"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
